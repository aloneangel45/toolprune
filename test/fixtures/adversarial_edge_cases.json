[
  {
    "name": "edge_empty_properties",
    "description": "Tool with completely empty properties object",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "edge_nested_oneof_anyof",
    "description": "Tool with nested oneOf and anyOf schemas inside object properties",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "dispatch_target": {
          "type": "object",
          "description": "Target configuration with polymorphic union alternatives",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "protocol": {
                  "type": "string",
                  "enum": ["grpc", "http2"]
                },
                "endpoint": {
                  "type": "string",
                  "description": "Fully qualified URI"
                }
              },
              "required": ["protocol", "endpoint"]
            },
            {
              "type": "object",
              "properties": {
                "socket_path": {
                  "type": "string",
                  "description": "UNIX domain socket filesystem path"
                }
              },
              "required": ["socket_path"]
            }
          ],
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "retries": {
                  "type": "integer",
                  "description": "Retry attempt count"
                }
              }
            }
          ]
        }
      },
      "required": ["dispatch_target"]
    }
  },
  {
    "name": "edge_no_descriptions",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "raw_id": {
          "type": "string"
        },
        "flags": {
          "type": "integer"
        }
      },
      "required": ["raw_id"]
    }
  },
  {
    "name": "edge_empty_string_descriptions",
    "description": "",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "param_blank": {
          "type": "string",
          "description": ""
        }
      }
    }
  }
]
